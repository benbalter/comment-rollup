{
  "compilerOptions": {
    "module": "Node16",
    "baseUrl": "./",
    "target": "es2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "allowJs": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "__tests__", "coverage", "dist", "eslint.config.mjs"],
  "ts-node": {
    "esm": true
  }
}