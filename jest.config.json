{
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": { "rootDir": "." } }]
  },
  "coveragePathIgnorePatterns": ["/node_modules/"],
  "testPathIgnorePatterns": ["/__tests__/fixtures.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.+)\\.js$": "$1"
  }
}
